{
  "name": "RunbookOps workshop",
  "build": {"dockerfile": "Dockerfile"},
  "postCreateCommand": "uv sync --frozen && uv run runbookops preflight",
  "forwardPorts": [8000, 8001],
  "portsAttributes": {
    "8000": {"label": "RunbookOps API", "onAutoForward": "notify"},
    "8001": {"label": "Authenticated MCP tools", "onAutoForward": "silent"}
  },
  "customizations": {"vscode": {"extensions": ["ms-python.python"]}}
}
