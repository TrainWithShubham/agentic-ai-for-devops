# Copy to .env. Never commit the real file.
RUNBOOKOPS_MODE=offline
RUNBOOKOPS_EMBEDDING=hash
RUNBOOKOPS_DATA=.state
OPENROUTER_API_KEY=
# Use `uv run runbookops models` to see current free tool-capable models.
OPENROUTER_MODEL=cohere/north-mini-code:free
RUNBOOKOPS_FREE_ONLY=true
RUNBOOKOPS_MAX_MODEL_CALLS=6
RUNBOOKOPS_MAX_OUTPUT_TOKENS=2048
# Optional explicit switch. No automatic paid-provider fallback.
GROQ_API_KEY=
GROQ_MODEL=
# Instructor only; install with `uv sync --extra aws`.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# Cloud deployment requires external state. Never put credentials in a commit.
RUNBOOKOPS_DATABASE_URL=
RUNBOOKOPS_MCP_URL=
RUNBOOKOPS_MCP_TOKEN=
RUNBOOKOPS_OIDC_ISSUER=
RUNBOOKOPS_OIDC_AUDIENCE=runbookops

# Optional, instructor cloud persistence; learners leave these empty.
RUNBOOKOPS_DYNAMODB_TABLE=
RUNBOOKOPS_CHECKPOINT_TABLE=
# Optional second explicitly free model for summarization.
OPENROUTER_SMALL_MODEL=

# Optional external issuer. Use escaped newlines for a public PEM value.
RUNBOOKOPS_OIDC_JWKS=
RUNBOOKOPS_OIDC_PUBLIC_KEY=

# Optional local browser persona login; CLI --demo-auth is preferred.
RUNBOOKOPS_UI_DEMO_AUTH=false
