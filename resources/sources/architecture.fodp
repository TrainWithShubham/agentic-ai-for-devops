<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.presentation">
<office:styles><style:style style:name="title" style:family="paragraph"><style:text-properties fo:font-size="28pt" fo:font-family="Arial" fo:color="#17253D"/></style:style><style:style style:name="body" style:family="paragraph"><style:text-properties fo:font-size="21pt" fo:font-family="Arial" fo:color="#26364A"/></style:style></office:styles>
<office:automatic-styles><style:page-layout style:name="pm1"><style:page-layout-properties fo:page-width="28cm" fo:page-height="15.75cm" style:print-orientation="landscape"/></style:page-layout><style:style style:name="dp1" style:family="drawing-page"><style:drawing-page-properties draw:fill="solid" draw:fill-color="#F7F8FA"/></style:style><style:style style:name="gr1" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="none"/></style:style></office:automatic-styles>
<office:master-styles><style:master-page style:name="Default" style:page-layout-name="pm1"/></office:master-styles><office:body><office:presentation><draw:page draw:name="Slide1" draw:style-name="dp1" draw:master-page-name="Default">
<draw:frame draw:style-name="gr1" svg:x="1.5cm" svg:y="1cm" svg:width="24cm" svg:height="2cm"><draw:text-box><text:p text:style-name="title">Service dependencies</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="gr1" svg:x="1.5cm" svg:y="4cm" svg:width="24cm" svg:height="8cm"><draw:text-box><text:p text:style-name="body">Customers browse the catalogue, then call checkout. Checkout calls the payment service. A working catalogue does not prove checkout is healthy.</text:p></draw:text-box></draw:frame>
</draw:page><draw:page draw:name="Slide2" draw:style-name="dp1" draw:master-page-name="Default">
<draw:frame draw:style-name="gr1" svg:x="1.5cm" svg:y="1cm" svg:width="24cm" svg:height="2cm"><draw:text-box><text:p text:style-name="title">Approved payment endpoint</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="gr1" svg:x="1.5cm" svg:y="4cm" svg:width="24cm" svg:height="8cm"><draw:text-box><text:p text:style-name="body">The simulator payment service listens at http://payments:9000. Checkout reads PAYMENT_SERVICE_URL from its configuration. An incorrect port can cause connection refused and HTTP 503.</text:p></draw:text-box></draw:frame>
</draw:page><draw:page draw:name="Slide3" draw:style-name="dp1" draw:master-page-name="Default">
<draw:frame draw:style-name="gr1" svg:x="1.5cm" svg:y="1cm" svg:width="24cm" svg:height="2cm"><draw:text-box><text:p text:style-name="title">Evidence and ownership</text:p></draw:text-box></draw:frame>
<draw:frame draw:style-name="gr1" svg:x="1.5cm" svg:y="4cm" svg:width="24cm" svg:height="8cm"><draw:text-box><text:p text:style-name="body">Bagha investigates operational evidence. Nattu Kaka maintains support records. Jethalal approves changes. This is a course simulator with synthetic data.</text:p></draw:text-box></draw:frame>
</draw:page></office:presentation></office:body></office:document>