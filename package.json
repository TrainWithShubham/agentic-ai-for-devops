{
  "name": "runbookops-ui-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/ui_*.test.mjs",
    "test:coverage": "c8 --check-coverage --lines 100 --statements 100 --functions 100 --branches 100 --all --include='src/runbookops/web/*.js' --reporter=text --reporter=json --reporter=html --reports-dir=artifacts/coverage/javascript node --test tests/ui_*.test.mjs"
  },
  "devDependencies": {
    "c8": "^9.1.0",
    "jsdom": "^31.0.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
